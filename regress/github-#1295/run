#!/bin/sh
# This regression test is a part of SIPp.
# A request whose method is 64 bytes or longer, or a message without a
# space, ends only its own call, not the run.
. "`dirname "$0"`/../functions"; init

sippbg -sn uas -i 127.0.0.1 -p 29510
uas=$pid
perl -e '
    use Socket;
    socket(S, PF_INET, SOCK_DGRAM, 17) or die $!;
    $to = pack_sockaddr_in(29510, inet_aton("127.0.0.1"));
    send(S, ("A" x 64) . " sip:x\@127.0.0.1 SIP/2.0\r\n"
        . "To: <sip:x\@127.0.0.1>\r\nCall-ID: long-method\r\n"
        . "CSeq: 1 INVITE\r\n\r\n", 0, $to) or die $!;
    send(S, "GARBAGE\r\nVia:SIP/2.0/UDP\r\nTo:<sip:x\@127.0.0.1>\r\n"
        . "Call-ID:no-space\r\n\r\n", 0, $to) or die $!;
' || fail "could not send"
sleep 0.5
/bin/kill -0 $uas 2>/dev/null || fail "the UAS exited"

sippfg -sn uac -i 127.0.0.1 -p 29511 -m 1 127.0.0.1:29510 \
    -timeout 10 -timeout_error >/dev/null 2>&1 || fail "the call failed"
ok
