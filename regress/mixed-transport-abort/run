#!/bin/sh
# This regression test is a part of SIPp.
# <send transport="auto">: an INVITE larger than 1300 bytes goes over TCP.
# When the call aborts on an unexpected 486, the ACK that SIPp sends of
# its own must go over TCP too (RFC 3261 section 17.1.1.2), not over the
# UDP of -t un: nothing listens there, and the UAS would wait for it.
. "`dirname "$0"`/../functions"; init

sippfg -sf uas.xml -t t1 -i 127.0.0.1 -p 25533 -m 1 -timeout 10 -timeout_error \
    >/dev/null 2>&1 &
uas=$!
sleep 1
sippfg -sf uac.xml -t un -i 127.0.0.1 -p 25532 -m 1 -timeout 10 \
    127.0.0.1:25533 >/dev/null 2>&1
uac_status=$?
wait $uas
uas_status=$?

# The UAC fails its call on the 486 (exit 1), as the scenario says.
if test $uac_status -ne 1; then
    fail "UAC exited with $uac_status, expected 1 (aborted call)"
elif test $uas_status -ne 0; then
    fail "UAS failed with $uas_status: no ACK over TCP"
else
    ok
fi
