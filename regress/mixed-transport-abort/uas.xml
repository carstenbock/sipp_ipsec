<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!-- Over TCP only: the ACK of the 486 must come here, over the INVITE's
     transport (RFC 3261 section 17.1.1.2), with a top Via of TCP. -->
<scenario name="mixed transport abort UAS">
  <recv request="INVITE"/>

  <send>
    <![CDATA[
      SIP/2.0 486 Busy Here
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <recv request="ACK">
    <action>
      <ereg regexp="^ *SIP/2\.0/TCP " search_in="hdr" header="Via:" check_it="true" assign_to="v1"/>
    </action>
  </recv>

  <Reference variables="v1"/>
</scenario>
