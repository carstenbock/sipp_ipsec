<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!-- The UDP side: the REGISTER and the BYE, each with a top Via of UDP -->
<scenario name="mixed transport UAS over UDP">
  <recv request="REGISTER">
    <action>
      <ereg regexp="^ *SIP/2\.0/UDP " search_in="hdr" header="Via:" check_it="true" assign_to="v1"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <recv request="BYE">
    <action>
      <ereg regexp="^ *SIP/2\.0/UDP " search_in="hdr" header="Via:" check_it="true" assign_to="v2"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>
  <Reference variables="v1,v2"/>
</scenario>
